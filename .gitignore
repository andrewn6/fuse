# Secrets / local env — never commit
.env
.env.*
!.env.example

# Build output
/bin/
*.test
coverage/
*.out

# Stray binaries from `go build ./cmd/...` at the repo root. the source
# packages share these names, so re-include the directories: without this
# every new file under fused/ or orchestrator/ is silently unstageable.
/fused
/orchestrator
!/fused/
!/orchestrator/

# OS / editor
.DS_Store

# GoReleaser build output
dist/

.claude

# docs site build/dep output (docs/ itself is tracked)
docs/node_modules/
docs/.next/
docs/.source/