version: 1

# a required secret with no value supplied. the refusal has to happen client
# side, before any network call, so the failure costs nothing and cannot leave
# a half-created environment behind.
resources:
  cpus: 1
  memory: 512MB
  storage: 2GB
  max_runtime: 10m

env:
  DATABASE_URL:
    secret: db_url

secrets:
  - db_url
  - api_token

run: |
  echo "should never run" > /workspace/never.txt
