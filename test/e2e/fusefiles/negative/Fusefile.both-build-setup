version: 1

# build and setup are the same field under two names, so setting both is
# ambiguous and rejected at parse time. this one never reaches an orchestrator:
# `fuse validate` alone must catch it.
resources:
  cpus: 1
  memory: 512MB
  storage: 2GB

build:
  - 'echo build'

setup:
  - 'echo setup'

run: |
  echo hi
