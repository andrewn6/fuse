version: 1

# the top-level env block (#173): literals and secret refs are resolved by the
# orchestrator into /fuse/env, which the startup script sources. the security
# property is that the secret's name and value never appear in the script text,
# only the path to the file.
#
# cache is off here, so build steps ride in the startup script and see the env.
# Fusefile.cache-env is the same manifest with cache on, where they do not.
resources:
  cpus: 1
  memory: 512MB
  storage: 2GB
  max_runtime: 20m

env:
  APP_MODE:
    value: production
  API_TOKEN:
    secret: api_token

secrets:
  - api_token

build:
  - 'printf "%s" "${APP_MODE:-UNSET}" > /workspace/build-mode.txt'
  - 'printf "%s" "${API_TOKEN:-UNSET}" > /workspace/build-token.txt'

run: |
  printf "%s" "${APP_MODE:-UNSET}" > /workspace/run-mode.txt
  printf "%s" "${API_TOKEN:-UNSET}" > /workspace/run-token.txt
  cp /fuse/env /workspace/fuse-env.copy 2>/dev/null || echo "NO /fuse/env" > /workspace/fuse-env.copy

workspace: /workspace
