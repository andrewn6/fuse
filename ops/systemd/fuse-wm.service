[Unit]
Description=Fuse desktop window manager (mutter on :1)
After=fuse-display.service
Requires=fuse-display.service

[Service]
Type=simple
Environment=DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/fuse-desktop
RuntimeDirectory=fuse-desktop
# the display unit is up as soon as xvfb forks, not as soon as the socket
# exists; wait for the socket so mutter never races its own display
ExecStartPre=/bin/sh -c 'i=0; while [ ! -S /tmp/.X11-unix/X1 ]; do i=$((i+1)); [ $i -gt 100 ] && exit 1; sleep 0.2; done'
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/mutter --x11 --sm-disable
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
